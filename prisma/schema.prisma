generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  pending
  paid
  fulfilled
  expired
  review
  cancelled
  refund_pending
  refunded
}

enum TicketStatus {
  issued
  used
  void
}

enum QrTokenStatus {
  active
  used
  expired
  revoked
}

enum ScanResult {
  ok
  already_used
  expired
  invalid
  revoked
}

enum PaymentEventStatus {
  received
  processed
  failed
  duplicate
}

enum EventStatus {
  draft
  on_sale
  sold_out
  closed
  cancelled
}

enum AdmissionType {
  general_admission
  reserved_seating
}

enum TicketSeatStatus {
  available
  reserved
  sold
  blocked
}

enum Sport {
  football
}

enum ClubMemberRole {
  owner
  admin
  box_office
  gate
}

enum FanWalletTransferPurpose {
  withdrawal
  order_payment
}

enum TreasurySweepStatus {
  pending
  submitting
  submitted
  complete
  failed
  review
}

model League {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  sport     Sport    @default(football)
  country   String?
  logoEmoji String?
  logoUrl   String?
  tier      Int      @default(100)
  createdAt DateTime @default(now())
  clubs     Club[]

  @@index([sport, tier])
}

model Club {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  treasuryAddress   String?
  leagueId          String?
  logoEmoji         String?
  logoUrl           String?
  sport             Sport              @default(football)
  createdAt         DateTime           @default(now())
  league            League?            @relation(fields: [leagueId], references: [id], onDelete: SetNull)
  circleAccount     ClubCircleAccount?
  events            Event[]
  fansFavorited     Fan[]              @relation("FavoriteClub")
  featured          Boolean            @default(false)
  fansFavoritedMany FanFavoriteClub[]
  members           ClubMember[]
  treasurySweeps    TreasurySweep[]

  @@index([leagueId])
}

model ClubMember {
  id             String         @id @default(cuid())
  clubId         String
  email          String
  supabaseUserId String?
  role           ClubMemberRole @default(admin)
  createdAt      DateTime       @default(now())
  joinedAt       DateTime?
  club           Club           @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@unique([clubId, email])
  @@unique([clubId, supabaseUserId])
  @@index([supabaseUserId])
  @@index([clubId, role])
}

model ClubCircleAccount {
  id          String   @id @default(cuid())
  clubId      String   @unique
  walletSetId String   @unique
  walletId    String   @unique
  chain       String   @default("ARC-TESTNET")
  createdAt   DateTime @default(now())
  club        Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
}

model Event {
  id                 String       @id @default(cuid())
  clubId             String
  name               String
  startsAt           DateTime
  venue              String
  status             EventStatus  @default(draft)
  cancelledAt        DateTime?
  cancellationReason String?
  archivedAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  club               Club         @relation(fields: [clubId], references: [id], onDelete: Restrict)
  ticketTypes        TicketType[]
  ticketAreas        TicketArea[]
  orders             Order[]
  tickets            Ticket[]

  @@index([clubId, startsAt])
  @@index([clubId, archivedAt, startsAt])
}

model TicketType {
  id               String      @id @default(cuid())
  eventId          String
  ticketAreaId     String
  name             String
  description      String?
  isTransferable   Boolean     @default(false)
  priceUsdc        Decimal     @db.Decimal(18, 6)
  quantityTotal    Int
  quantityReserved Int         @default(0)
  quantitySold     Int         @default(0)
  maxPerOrder      Int         @default(8)
  isActive         Boolean     @default(true)
  salesStartAt     DateTime?
  salesEndAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  event            Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketArea       TicketArea  @relation(fields: [ticketAreaId], references: [id], onDelete: Restrict)
  orderItems       OrderItem[]

  @@index([eventId])
  @@index([ticketAreaId])
}

model TicketArea {
  id                 String        @id @default(cuid())
  eventId            String
  name               String
  admissionType      AdmissionType @default(general_admission)
  sectionLabel       String?
  rowLabel           String?
  seatStartNumber    Int?
  entranceLabel      String?
  accessInstructions String?
  quantityTotal      Int
  quantityReserved   Int           @default(0)
  quantitySold       Int           @default(0)
  maxPerOrder        Int           @default(8)
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  event              Event         @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketTypes        TicketType[]
  seats              TicketSeat[]

  @@index([eventId, isActive])
}

model Fan {
  id                String              @id @default(cuid())
  supabaseUserId    String?             @unique
  email             String              @unique
  displayName       String?
  avatarUrl         String?
  themePreference   String              @default("system")
  favoriteClubId    String?
  createdAt         DateTime            @default(now())
  favoriteClub      Club?               @relation("FavoriteClub", fields: [favoriteClubId], references: [id], onDelete: SetNull)
  wallet            FanCircleWallet?
  orders            Order[]
  tickets           Ticket[]
  preferredCurrency String              @default("USDC")
  favoriteClubs     FanFavoriteClub[]
  walletTransfers   FanWalletTransfer[]

  @@index([favoriteClubId])
}

model FanCircleWallet {
  id        String              @id @default(cuid())
  fanId     String              @unique
  userId    String
  walletId  String              @unique
  address   String
  chain     String              @default("ARC-TESTNET")
  createdAt DateTime            @default(now())
  fan       Fan                 @relation(fields: [fanId], references: [id], onDelete: Restrict)
  transfers FanWalletTransfer[]
}

model FanWalletTransfer {
  id                 String                   @id @default(cuid())
  fanId              String
  fanCircleWalletId  String
  orderId            String?
  purpose            FanWalletTransferPurpose
  destinationAddress String
  amountUsdc         Decimal                  @db.Decimal(18, 6)
  tokenId            String
  idempotencyKey     String                   @unique
  challengeId        String?                  @unique
  challengeStatus    String                   @default("created")
  failureReason      String?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  challengeUpdatedAt DateTime?
  fan                Fan                      @relation(fields: [fanId], references: [id], onDelete: Restrict)
  wallet             FanCircleWallet          @relation(fields: [fanCircleWalletId], references: [id], onDelete: Restrict)
  order              Order?                   @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([fanId, createdAt])
  @@index([orderId])
  @@index([challengeStatus, createdAt])
}

model FanFavoriteClub {
  fanId     String
  clubId    String
  createdAt DateTime @default(now())
  fan       Fan      @relation(fields: [fanId], references: [id], onDelete: Cascade)
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)

  @@id([fanId, clubId])
  @@index([fanId])
}

model Order {
  id                  String              @id @default(cuid())
  fanId               String
  eventId             String
  status              OrderStatus         @default(pending)
  totalUsdc           Decimal             @db.Decimal(18, 6)
  depositAddress      String              @unique
  depositAddressKeyId String?
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  paidAt              DateTime?
  fulfilledAt         DateTime?
  fan                 Fan                 @relation(fields: [fanId], references: [id], onDelete: Restrict)
  event               Event               @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  payments            Payment[]
  walletTransfers     FanWalletTransfer[]
  treasurySweep       TreasurySweep?

  @@index([fanId, createdAt])
  @@index([status])
}

model TreasurySweep {
  id                    String              @id @default(cuid())
  orderId               String              @unique
  clubId                String
  sourceWalletId        String
  destinationWalletId   String
  amountUsdc            Decimal             @db.Decimal(18, 6)
  tokenId               String?
  sweptAmountUsdc       Decimal?            @db.Decimal(18, 6)
  networkFeeUsdc        Decimal?            @db.Decimal(18, 6)
  status                TreasurySweepStatus @default(pending)
  providerTransactionId String?             @unique
  failureReason         String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  submittedAt           DateTime?
  completedAt           DateTime?
  order                 Order               @relation(fields: [orderId], references: [id], onDelete: Restrict)
  club                  Club                @relation(fields: [clubId], references: [id], onDelete: Restrict)

  @@index([clubId, status, createdAt])
  @@index([sourceWalletId, status])
}

model OrderItem {
  id                 String         @id @default(cuid())
  orderId            String
  ticketTypeId       String
  quantity           Int
  unitPriceUsdc      Decimal        @db.Decimal(18, 6)
  ticketTypeName     String?
  admissionType      AdmissionType?
  sectionLabel       String?
  rowLabel           String?
  entranceLabel      String?
  accessInstructions String?
  isTransferable     Boolean        @default(false)
  order              Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketType         TicketType     @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets            Ticket[]
  seats              TicketSeat[]

  @@index([orderId])
}

model PaymentEvent {
  id             String             @id @default(cuid())
  circleEventId  String             @unique
  eventType      String
  rawPayload     Json
  signatureKeyId String?
  status         PaymentEventStatus @default(received)
  receivedAt     DateTime           @default(now())
  processedAt    DateTime?

  @@index([status, receivedAt])
}

model Payment {
  id                    String   @id @default(cuid())
  orderId               String
  providerTransactionId String   @unique
  amountUsdc            Decimal  @db.Decimal(18, 6)
  depositAddress        String
  chain                 String   @default("ARC-TESTNET")
  sourceAddress         String?
  confirmedAt           DateTime @default(now())
  order                 Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

model Ticket {
  id                 String         @id @default(cuid())
  orderItemId        String
  eventId            String
  fanId              String
  seatId             String?        @unique
  status             TicketStatus   @default(issued)
  ticketTypeName     String?
  admissionType      AdmissionType?
  sectionLabel       String?
  rowLabel           String?
  seatLabel          String?
  entranceLabel      String?
  accessInstructions String?
  isTransferable     Boolean        @default(false)
  createdAt          DateTime       @default(now())
  orderItem          OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  event              Event          @relation(fields: [eventId], references: [id], onDelete: Restrict)
  fan                Fan            @relation(fields: [fanId], references: [id], onDelete: Restrict)
  seat               TicketSeat?    @relation(fields: [seatId], references: [id], onDelete: SetNull)
  qrToken            QrToken?

  @@index([eventId, status])
  @@index([fanId])
}

model TicketSeat {
  id           String           @id @default(cuid())
  ticketAreaId String
  orderItemId  String?
  label        String
  sectionLabel String?
  rowLabel     String?
  seatNumber   String?
  sortOrder    Int
  status       TicketSeatStatus @default(available)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  ticketArea   TicketArea       @relation(fields: [ticketAreaId], references: [id], onDelete: Restrict)
  orderItem    OrderItem?       @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  ticket       Ticket?

  @@unique([ticketAreaId, label])
  @@index([ticketAreaId, status, sortOrder])
  @@index([orderItemId])
}

model QrToken {
  id        String        @id @default(cuid())
  ticketId  String        @unique
  tokenHash String        @unique
  status    QrTokenStatus @default(active)
  issuedAt  DateTime      @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  version   Int           @default(1)
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  scans     ScanEvent[]

  @@index([status, expiresAt])
}

model ScanEvent {
  id        String     @id @default(cuid())
  qrTokenId String?
  ticketId  String?
  result    ScanResult
  scannedAt DateTime   @default(now())
  scannerId String?
  ipHash    String?
  qrToken   QrToken?   @relation(fields: [qrTokenId], references: [id], onDelete: SetNull)

  @@index([qrTokenId, scannedAt])
  @@index([result, scannedAt])
}
